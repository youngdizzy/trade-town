# Copy to .env and adjust for your environment. Never commit a real .env file.

# SQLite by default; swap for postgresql://user:pass@host/db when moving to Postgres (future-ready).
DATABASE_URL=sqlite:///./data/tradetown.db

# Comma-separated list of origins allowed to call the API / open the WebSocket.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Simulation pacing.
TICK_INTERVAL_SECONDS=2.0
GAME_MINUTES_PER_TICK=5
PERSIST_INTERVAL_TICKS=15

HOST=0.0.0.0
PORT=8000
