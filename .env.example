# Copy to .env at the repo root to override docker-compose.yml defaults.
# Never commit a real .env file — it's gitignored.

# Host interface the frontend's nginx port is bound to. Defaults to 127.0.0.1
# (loopback only) because /api and /ws have no authentication of their own and
# /ws broadcasts full game state. Reach the UI over an SSH tunnel:
#   ssh -L 8080:127.0.0.1:80 <vps>     then open http://localhost:8080
# Set this to 0.0.0.0 ONLY if you have deliberately put authentication in
# front of /api and /ws.
HTTP_BIND=127.0.0.1

# Port the frontend's nginx binds to on the host.
HTTP_PORT=80

# TradeTown Read-Only MCP Boundary 1.0 — bearer credential for the external
# tt-scout agent. REQUIRED: the mcp-service container refuses to start without
# it. Generate one with:  openssl rand -hex 32
# Never commit a real value — this file is the template, .env is gitignored.
MCP_BEARER_TOKEN=replace-me-with-a-random-64-hex-string
MCP_EXTERNAL_AGENT_ID=tt-scout

# Backend settings (see backend/.env.example for the full list / non-Docker use).
DATABASE_URL=sqlite:///./data/tradetown.db
# The browser only ever talks to nginx (same origin as the page), which proxies
# to the backend internally — so this rarely matters in the standard deployment.
# It's only relevant if something calls the backend directly, bypassing nginx.
CORS_ORIGINS=http://localhost
TICK_INTERVAL_SECONDS=2.0
GAME_MINUTES_PER_TICK=5
PERSIST_INTERVAL_TICKS=15
