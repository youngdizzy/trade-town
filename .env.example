# Copy to .env at the repo root to override docker-compose.yml defaults.
# Never commit a real .env file — it's gitignored.

# Port the frontend's nginx binds to on the host.
HTTP_PORT=80

# Backend settings (see backend/.env.example for the full list / non-Docker use).
DATABASE_URL=sqlite:///./data/tradetown.db
CORS_ORIGINS=http://localhost
TICK_INTERVAL_SECONDS=2.0
GAME_MINUTES_PER_TICK=5
PERSIST_INTERVAL_TICKS=15
