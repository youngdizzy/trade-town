# Example HOST-level nginx vhost for a production VPS deployment where nginx
# on the host terminates TLS and proxies to the dockerized stack.
#
# This is a different nginx than frontend/deploy/nginx.conf (that one runs
# INSIDE the frontend container and proxies /api + /ws to the backend
# container over the Docker network). This one sits in front of the whole
# docker compose stack and handles the public domain + HTTPS.
#
# Usage on the VPS:
#   1. Run the stack with `docker compose up -d --build` (binds to 127.0.0.1:${HTTP_PORT}
#      — set HTTP_PORT=8080 or similar in .env so it doesn't fight this host nginx for :80).
#   2. Copy this file to /etc/nginx/sites-available/tradetown.conf, adjust
#      server_name and the upstream port, then symlink it into sites-enabled.
#   3. Obtain a certificate (e.g. `certbot --nginx -d your-domain.example`),
#      which will rewrite the TLS block below automatically.

upstream tradetown_app {
    server 127.0.0.1:8080; # matches HTTP_PORT in the repo root .env
}

server {
    listen 80;
    server_name your-domain.example;

    # certbot will add a redirect to HTTPS here once a certificate is issued.

    # See frontend/deploy/nginx.conf's own comment on this same directive —
    # a defensive ceiling, not the fix for the save-payload size this app
    # used to send (see backend/app/schemas.py's ClientSaveRequest).
    client_max_body_size 4m;

    location / {
        proxy_pass http://tradetown_app;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
    }
}

